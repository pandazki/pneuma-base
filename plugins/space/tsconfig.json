{
  // tsc only checks the types; scripts/build.mjs bundles. Tests import the sources directly: Node
  // (22.18 and newer) strips the types as it loads them, so relative imports end in .ts and only
  // syntax that erases is allowed (no enum, no parameter property).
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
