{
  "name": "pneuma-base-plugin-space",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A Pneuma Base plugin that deploys a library’s websites to PneumaSpace.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "install-local": "npm run build && pneuma-base plugin install dist",
    "proof": "sh scripts/proof.sh",
    "shots": "npm run build && node scripts/shots.mjs"
  },
  "devDependencies": {
    "@pneuma-base/sdk": "file:../../dist-packages/pneuma-base-sdk-0.9.0.tgz",
    "pneuma-base": "file:../../dist-packages/pneuma-base-0.9.0.tgz",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@types/node": "26.6.10"
  }
}
