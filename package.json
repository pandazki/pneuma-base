{
  "name": "pneuma-base-workspace",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm build:core && tsc -b packages/cli && pnpm --filter @pneuma-base/viewer build:web",
    "build:core": "cargo build --release --manifest-path core/Cargo.toml",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && playwright test -c packages/viewer/e2e/playwright.config.ts",
    "pack:dist": "pnpm build && node scripts/pack-dist.mjs",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "test:slow": "pnpm build && vitest run -c vitest.slow.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
